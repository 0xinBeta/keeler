{
  "name": "keeler",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  // The Worker runs first for every path so HTML gets the CSP and hashed files a long cache.
  // The binding is STATIC because the ASSETS var holds the token list.
  "assets": { "directory": "../web/dist", "binding": "STATIC", "not_found_handling": "single-page-application", "run_worker_first": true },
  // Per client (IPv4 address or IPv6 /64) unless named GLOBAL. period must be 10 or 60 seconds.
  "ratelimits": [
    { "name": "RPC_LIMIT", "namespace_id": "4101", "simple": { "limit": 600, "period": 60 } },
    { "name": "QUOTE_LIMIT", "namespace_id": "4102", "simple": { "limit": 30, "period": 60 } },
    { "name": "FAUCET_LIMIT", "namespace_id": "4103", "simple": { "limit": 3, "period": 60 } },
    { "name": "SPR_LIMIT", "namespace_id": "4104", "simple": { "limit": 300, "period": 60 } },
    // Each proof costs 1,000 Helius credits.
    { "name": "PROVE_LIMIT", "namespace_id": "4105", "simple": { "limit": 20, "period": 60 } },
    // Global (constant key) caps on spend, whatever the number of client addresses. Tune to the Helius plan.
    { "name": "RPC_GLOBAL_LIMIT", "namespace_id": "4106", "simple": { "limit": 1200, "period": 60 } },
    { "name": "SPR_GLOBAL_LIMIT", "namespace_id": "4107", "simple": { "limit": 1200, "period": 60 } },
    { "name": "PROVE_GLOBAL_LIMIT", "namespace_id": "4108", "simple": { "limit": 30, "period": 60 } },
    // The lending keeper: one lane per pool, a build is two proofs, a ticket a signature. A tab with a request in
    // flight reads its account every 3 s (about 21 reads a minute with the pool figures), so 120 leaves room for
    // several tabs behind one address. Builds have no global limit: the keeper's lane paces them.
    { "name": "LEND_READ_LIMIT", "namespace_id": "4109", "simple": { "limit": 120, "period": 60 } },
    { "name": "LEND_READ_GLOBAL_LIMIT", "namespace_id": "4110", "simple": { "limit": 1200, "period": 60 } },
    { "name": "LEND_TICKET_LIMIT", "namespace_id": "4111", "simple": { "limit": 10, "period": 60 } },
    { "name": "LEND_TICKET_GLOBAL_LIMIT", "namespace_id": "4112", "simple": { "limit": 60, "period": 60 } },
    { "name": "LEND_BUILD_LIMIT", "namespace_id": "4113", "simple": { "limit": 6, "period": 60 } }
  ],
  "vars": { "NETWORK": "local" }
}
